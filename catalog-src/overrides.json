  "sources": [
   {
      "id": "lede-master",
      "name": "LEDE",
      "repo_url": "https://github.com/coolsnowwolf/lede",
      "branch": "master"
    }
  ],
  "overrides": {
    "luci-app-passwall": {
      "desc": "多节点、分流规则完整的代理工具。",
      "tut": "装好后先添加订阅，再选择分流模式。",
      "size_mb": 1.8,
      "rec": false
    },
    "luci-app-openclash": {
      "desc": "兼容 Clash 配置的代理客户端，内核体积较大。",
      "tut": "上传配置文件或订阅地址，并下载内核。",
      "size_mb": 9,
      "rec": false
    },
    "luci-app-homeproxy": {
      "desc": "基于 sing-box 的轻量代理，界面简洁。",
      "tut": "在「服务 → HomeProxy」导入节点即可。",
      "size_mb": 3.5,
      "rec": false
    },
    "luci-app-smartdns": {
      "desc": "多上游并发解析，选最快的结果。",
      "tut": "勾选「重定向 53 端口」即可生效。",
      "size_mb": 1.2,
      "rec": false
    },
    "luci-app-ddns-go": {
      "desc": "自动把公网 IP 解析到你的域名。",
      "tut": "打开 9876 端口，填写服务商密钥。",
      "size_mb": 3,
      "rec": false
    },
    "luci-app-mwan3": {
      "desc": "多条宽带叠加或互为备份。",
      "tut": "先添加接口，再设置成员和策略。",
      "size_mb": 0.2,
      "rec": false
    },
    "luci-proto-wireguard": {
      "desc": "在外也能安全回家访问内网。",
      "tut": "「网络 → 接口」新增 WireGuard 协议。",
      "size_mb": 0.1,
      "rec": false
    },
    "luci-app-upnp": {
      "desc": "让下载、游戏程序自动开放端口。",
      "tut": "勾选启用即可，注意安全风险。",
      "size_mb": 0.1,
      "rec": false
    },
    "luci-app-openlist": {
      "desc": "把多个网盘聚合成统一的文件目录。",
      "tut": "首次启动后在日志里查看管理员密码。",
      "size_mb": 12,
      "rec": false
    },
    "luci-app-samba4": {
      "desc": "局域网内共享硬盘文件夹。",
      "tut": "先挂载硬盘，再添加共享目录。",
      "size_mb": 2.5,
      "rec": false
    },
    "luci-app-qbittorrent": {
      "desc": "功能完整的 BT 下载客户端。",
      "tut": "默认端口 8080，请修改初始密码。",
      "size_mb": 6,
      "rec": false
    },
    "luci-app-aria2": {
      "desc": "轻量多线程下载，可配合网页界面。",
      "tut": "设置下载目录后即可使用。",
      "size_mb": 1.5,
      "rec": false
    },
    "luci-app-ttyd": {
      "desc": "在浏览器里直接打开路由器命令行。",
      "tut": "进入「系统 → 终端」。",
      "size_mb": 0.3,
      "rec": false
    },
    "luci-app-netdata": {
      "desc": "实时查看 CPU、流量、温度曲线。",
      "tut": "打开 19999 端口查看仪表盘。",
      "size_mb": 5,
      "rec": false
    },
    "luci-app-unblockneteasemusic": {
      "desc": "解除网易云音乐的播放限制。",
      "tut": "启用后按说明设置设备代理。",
      "size_mb": 2.8,
      "rec": false
    },
    "luci-app-dockerman": {
      "desc": "运行容器，体积和内存占用都较大。",
      "tut": "需要外接存储，空间小的设备不建议。",
      "size_mb": 30,
      "rec": false
    },
    "luci-app-autoreboot": {
      "desc": "按计划自动重启，保持稳定。",
      "tut": "设置每天或每周的重启时间。",
      "size_mb": 0.05,
      "rec": false
    },
    "luci-theme-argon": {
      "desc": "清爽的深浅色自适应界面。",
      "tut": "在「系统 → 主题」切换。",
      "size_mb": 0.6,
      "rec": false
    }
  },
  "extras": [
    {
      "id": "luci-app-store",
      "name": "iStore 软件中心",
      "desc": "固件只带基础功能，装机后在路由器里按需安装更多插件，大幅减小固件。",
      "cat": "系统",
      "kind": "app",
      "origin": {
        "type": "feed",
        "name": "istore",
        "line": "src-git istore https://github.com/linkease/istore;main"
      },
      "deps": [],
      "requires": [
        "luci-compat"
      ],
      "size_mb": 0.6,
      "rec": true,
      "tut": "进入「系统 → 软件中心」，每个应用都附带教程。",
      "tags": []
    },
    {
      "id": "luci-app-socat",
      "name": "Socat 端口转发",
      "desc": "功能较全的 TCP/UDP 转发工具（作者自维护仓库）。",
      "cat": "网络",
      "kind": "app",
      "origin": {
        "type": "git",
        "name": "luci-app-socat",
        "url": "https://github.com/mylucien/luci-app-socat",
        "branch": "",
        "sparse": false,
        "dirs": []
      },
      "deps": [
        "socat"
      ],
      "requires": [],
      "size_mb": 0.1,
      "rec": false,
      "tut": "在「网络 → Socat」添加规则。",
      "tags": []
    }
  ]
}
